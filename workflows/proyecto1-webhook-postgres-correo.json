{
  "name": "Proyecto 1 - Webhook a PostgreSQL y correo",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "contacto",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "5f1c2b7e-1d2a-4c3b-9e4f-contacto0001"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO contactos (nombre, email, mensaje) VALUES ($1, $2, $3) RETURNING *;",
        "options": {
          "queryReplacement": "={{ [$json.body.nombre, $json.body.email, $json.body.mensaje] }}"
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Guardar en PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [240, 0]
    },
    {
      "parameters": {
        "fromEmail": "TU_CORREO@gmail.com",
        "toEmail": "TU_CORREO@gmail.com",
        "subject": "=Nuevo contacto #{{ $json.id }}: {{ $json.nombre }}",
        "emailFormat": "html",
        "html": "=<h2>Nuevo contacto recibido</h2><p><b>Nombre:</b> {{ $json.nombre }}</p><p><b>Email:</b> {{ $json.email }}</p><p><b>Mensaje:</b> {{ $json.mensaje }}</p><p><small>Registrado el {{ $json.creado_en }} (id {{ $json.id }})</small></p>",
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Enviar correo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [480, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"id\": $('Guardar en PostgreSQL').item.json.id, \"mensaje\": \"Contacto registrado\" } }}",
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 0]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Guardar en PostgreSQL", "type": "main", "index": 0 }]] },
    "Guardar en PostgreSQL": { "main": [[{ "node": "Enviar correo", "type": "main", "index": 0 }]] },
    "Enviar correo": { "main": [[{ "node": "Responder", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
